# Copiá este archivo como .env y completalo. .env está en .gitignore: nunca se sube.
# Token que te da @BotFather al crear el bot del Radar
TELEGRAM_BOT_TOKEN=
# Tu chat privado con el bot (se obtiene con getUpdates después de enviarle /start)
TELEGRAM_CHAT_ID=
# Adzuna (opcional; 25 consultas de prueba, luego £8/mes): developer.adzuna.com → Dashboard → API Access Details
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Gmail (alertas por correo): cliente OAuth de escritorio de Google Cloud (ver docs/guia-gmail.md)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Lo completa solo: python -m radar.gmail_auth
GMAIL_REFRESH_TOKEN=
